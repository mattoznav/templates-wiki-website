---
import Base from "../layouts/Base.astro";
import { getGames, getGenerations, getIndex, getMeta, getTypes, entryById } from "../lib/data";
import { ROMAN, pad } from "../lib/format";
import { withBase } from "../lib/paths";

const index = getIndex();
const meta = getMeta();
const types = getTypes();
const games = getGames();
const generations = getGenerations().map((g) => {
  const first = g.species[0];
  const years = games.filter((x) => x.generation === g.number && x.year).map((x) => x.year!);
  return {
    ...g,
    // The first three partner Pokémon open every generation, three entries apart
    partners: [first, first + 3, first + 6].map((id) => entryById(id)).filter((e) => e !== undefined),
    from: years.length ? Math.min(...years) : null,
  };
});

const featuredSlugs = [
  "pikachu", "eevee", "gengar", "lucario", "gardevoir", "dragonite", "umbreon", "greninja",
  "mimikyu", "sylveon", "garchomp", "charizard", "snorlax", "lapras", "rayquaza", "tyranitar",
  "absol", "togekiss", "decidueye", "corviknight", "tinkaton", "ceruledge", "dragapult", "ampharos",
];
const featured = featuredSlugs
  .map((slug) => index.find((e) => e.slug === slug))
  .filter((e) => e !== undefined)
  .map((e) => ({ slug: e.slug, name: e.name, id: e.id, genus: e.genus, types: e.types, artwork: e.artwork, total: e.total }));
const first = featured[0];
const typeCounts = new Map(types.map((t) => [t.slug, index.filter((e) => e.types.includes(t.slug)).length]));
const stats = [
  { n: meta.counts.species, label: "species" },
  { n: meta.counts.forms, label: "forms" },
  { n: meta.counts.moves, label: "moves" },
  { n: meta.counts.abilities, label: "abilities" },
  { n: meta.counts.games, label: "games" },
];
---

<Base>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="copy rise">
        <span class="label">An unofficial field guide</span>
        <h1>Every Pokémon,<br /><em>one</em> field guide.</h1>
        <p class="lede">
          Stats, evolutions, type matchups, learnsets and the games they come from, for all {
            meta.counts.species.toLocaleString("en")
          } species. Everything links to everything else.
        </p>
        <div class="search-row">
          <label class="big-search">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"
              ><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5" stroke-linecap="round"></path></svg
            >
            <span class="sr-only">Search the guide</span>
            <input type="search" placeholder="Try “Gengar”, “Thunderbolt” or 448" data-search-field />
            <kbd class="mono">/</kbd>
          </label>
          <button class="btn" type="button" data-random={index.map((e) => e.slug).join(" ")}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"
              ><rect x="3" y="3" width="18" height="18" rx="4"></rect><circle cx="8.5" cy="8.5" r="1.3" fill="currentColor"
              ></circle><circle cx="15.5" cy="15.5" r="1.3" fill="currentColor"></circle><circle
                cx="12"
                cy="12"
                r="1.3"
                fill="currentColor"></circle></svg
            >
            Random entry
          </button>
        </div>
      </div>

      {
        first && (
          <a class="specimen" href={withBase(`/pokemon/${first.slug}/`)} data-type={first.types[0]} data-featured={JSON.stringify(featured)}>
            <span class="pin label">Featured entry</span>
            <span class="specimen-art dots">
              <img src={first.artwork} alt="" width="360" height="360" fetchpriority="high" />
            </span>
            <span class="specimen-meta">
              <span class="mono no">#{pad(first.id)}</span>
              <span class="nm">{first.name}</span>
              <span class="gn">{first.genus}</span>
              <span class="types">
                {first.types.map((t) => (
                  <span class="type" data-type={t}>
                    {t}
                  </span>
                ))}
              </span>
            </span>
          </a>
        )
      }
    </div>
    <div class="wrap">
      <dl class="counts">
        {
          stats.map((s) => (
            <div>
              <dt class="label">{s.label}</dt>
              <dd>{s.n.toLocaleString("en")}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Browse by generation</h2>
        <a href={withBase("/games/")} class="label">All games →</a>
      </div>
      <div class="gens">
        {
          generations.map((g) => (
            <a class="gen" href={withBase(`/games/${g.slug}/`)}>
              <span class="gen-top">
                <span class="mono roman">{ROMAN[g.number]}</span>
                <span class="label">{g.from}</span>
              </span>
              <span class="partners" aria-hidden="true">
                {g.partners.map((p) => (
                  <img src={p!.artwork} alt="" width="72" height="72" loading="lazy" />
                ))}
              </span>
              <span class="region">{g.region}</span>
              <span class="muted small">{g.species.length} new species</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Browse by type</h2>
        <a href={withBase("/types/")} class="label">Type chart →</a>
      </div>
      <div class="type-grid">
        {
          types.map((t) => (
            <a class="type-tile" href={withBase(`/types/${t.slug}/`)} data-type={t.slug}>
              <span class="tt-name">{t.name}</span>
              <span class="mono tt-count">{typeCounts.get(t.slug)}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap notes">
      <div>
        <span class="label">How it works</span>
        <h2>Fast because it is finished before you arrive.</h2>
      </div>
      <ul class="note-list">
        <li>
          <strong>Built from open data.</strong> A build step reads PokéAPI once, caches it, and turns it into {
            (meta.counts.species + meta.counts.moves + meta.counts.abilities).toLocaleString("en")
          }+ static pages.
        </li>
        <li><strong>Cross-linked.</strong> Every move lists who learns it, every ability who has it, every type what it beats.</li>
        <li><strong>Search everything.</strong> Press <kbd class="mono">/</kbd> anywhere to jump to any Pokémon, move, ability or type.</li>
      </ul>
    </div>
  </section>
</Base>

<script>
  import { withBase } from "../lib/paths";

  // Random entry
  document.querySelector<HTMLButtonElement>("[data-random]")?.addEventListener("click", (e) => {
    const slugs = (e.currentTarget as HTMLElement).dataset.random!.split(" ");
    location.href = withBase(`/pokemon/${slugs[Math.floor(Math.random() * slugs.length)]}/`);
  });

  // A different featured entry on each visit
  const card = document.querySelector<HTMLAnchorElement>("[data-featured]");
  if (card) {
    const list = JSON.parse(card.dataset.featured!) as {
      slug: string; name: string; id: number; genus: string; types: string[]; artwork: string;
    }[];
    const pick = list[Math.floor(Math.random() * list.length)];
    card.href = withBase(`/pokemon/${pick.slug}/`);
    card.dataset.type = pick.types[0];
    card.querySelector("img")!.src = pick.artwork;
    card.querySelector(".no")!.textContent = `#${String(pick.id).padStart(4, "0")}`;
    card.querySelector(".nm")!.textContent = pick.name;
    card.querySelector(".gn")!.textContent = pick.genus;
    card.querySelector(".types")!.innerHTML = pick.types
      .map((t) => `<span class="type" data-type="${t}">${t}</span>`)
      .join("");
  }
</script>

<style>
  .hero {
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
    gap: clamp(32px, 6vw, 80px);
    align-items: center;
    padding-block: clamp(48px, 8vw, 104px) clamp(32px, 5vw, 56px);
  }

  .copy h1 {
    margin-top: 18px;
    font-size: clamp(2.8rem, 6.4vw, 5.4rem);
  }

  .copy h1 em {
    font-style: italic;
    color: var(--accent);
    font-variation-settings: "SOFT" 100, "WONK" 1;
  }

  .copy .lede {
    margin-top: 24px;
  }

  .search-row {
    display: flex;
    gap: 10px;
    margin-top: 32px;
    flex-wrap: wrap;
  }

  .big-search {
    flex: 1 1 320px;
    display: flex;
    align-items: center;
    gap: 12px;
    height: 56px;
    padding: 0 12px 0 18px;
    border-radius: 999px;
    border: 1px solid var(--line-2);
    background: var(--card);
    color: var(--muted);
    box-shadow: var(--shadow);
    cursor: text;
  }

  .big-search input {
    flex: 1;
    border: 0;
    background: none;
    outline: none;
    font-size: 1.05rem;
    color: var(--ink);
    min-width: 0;
  }

  .search-row .btn {
    height: 56px;
    padding: 0 22px;
  }

  .specimen {
    position: relative;
    display: flex;
    flex-direction: column;
    border-radius: 24px;
    background: var(--card);
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
    text-decoration: none;
    transform: rotate(2deg);
    transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .specimen:hover {
    transform: rotate(0deg) translateY(-4px);
  }

  .specimen::before {
    content: "";
    position: absolute;
    inset: 10px -10px -10px 10px;
    z-index: -1;
    border-radius: 24px;
    border: 1px solid var(--line);
    background: var(--paper-2);
    transform: rotate(-4deg);
  }

  .pin {
    position: absolute;
    top: 14px;
    left: 16px;
    z-index: 1;
  }

  .specimen-art {
    aspect-ratio: 1;
    margin: 8px;
    border-radius: 18px;
    background-color: color-mix(in oklab, var(--c) 16%, var(--card));
    display: grid;
    place-items: center;
  }

  .specimen-art img {
    width: 80%;
    height: 80%;
    object-fit: contain;
    filter: drop-shadow(0 16px 20px rgb(0 0 0 / 0.2));
  }

  .specimen-meta {
    display: grid;
    gap: 4px;
    padding: 10px 20px 20px;
  }

  .no {
    color: var(--muted);
    font-size: 0.8rem;
  }

  .nm {
    font-family: var(--font-display);
    font-size: 1.8rem;
    font-weight: 580;
    letter-spacing: -0.02em;
    line-height: 1.05;
  }

  .gn {
    color: var(--ink-2);
    font-style: italic;
    font-family: var(--font-display);
    margin-bottom: 8px;
  }

  .counts {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    margin: 0 0 clamp(32px, 5vw, 56px);
    border-top: 1px solid var(--line);
  }

  .counts div {
    padding: 18px 0 0;
  }

  .counts div + div {
    padding-left: 20px;
    border-left: 1px solid var(--line);
  }

  .counts dd {
    margin: 6px 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3.4vw, 2.6rem);
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .gens {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 14px;
  }

  .gen {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 18px;
    border-radius: var(--radius);
    background: var(--card);
    border: 1px solid var(--line);
    text-decoration: none;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .gen:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
  }

  .gen-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .roman {
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--accent);
  }

  .partners {
    display: flex;
    margin: 6px 0 4px -6px;
  }

  .partners img {
    width: 64px;
    height: 64px;
    object-fit: contain;
  }

  .partners img + img {
    margin-left: -14px;
  }

  .region {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 560;
  }

  .small {
    font-size: 0.85rem;
  }

  .type-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 10px;
  }

  .type-tile {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 16px 16px 18px;
    border-radius: 12px;
    text-decoration: none;
    background: color-mix(in oklab, var(--c) 14%, var(--card));
    border: 1px solid color-mix(in oklab, var(--c) 40%, transparent);
    border-left: 5px solid var(--c);
    transition: background 0.2s;
  }

  .type-tile:hover {
    background: color-mix(in oklab, var(--c) 26%, var(--card));
  }

  .tt-name {
    font-weight: 600;
  }

  .tt-count {
    font-size: 0.8rem;
    color: var(--ink-2);
  }

  .notes {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: start;
  }

  .notes h2 {
    margin-top: 12px;
  }

  .note-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
    color: var(--ink-2);
  }

  .note-list li {
    padding-left: 18px;
    border-left: 2px solid var(--line-2);
  }

  .note-list strong {
    color: var(--ink);
  }

  @media (max-width: 900px) {
    .hero-grid,
    .notes {
      grid-template-columns: 1fr;
    }

    .specimen {
      max-width: 340px;
      margin-inline: auto;
      width: 100%;
    }
  }

  @media (max-width: 640px) {
    .counts {
      grid-template-columns: repeat(3, 1fr);
    }

    .counts div:nth-child(4) {
      padding-left: 0;
      border-left: 0;
    }
  }
</style>
