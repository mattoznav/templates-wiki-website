---
import "../styles/global.css";
import Logo from "../components/Logo.astro";
import { getMeta } from "../lib/data";

interface Props {
  title?: string;
  description?: string;
  image?: string | null;
}

const { title, description, image } = Astro.props;
const site = "Fieldbook";
const fullTitle = title ? `${title} · ${site}` : `${site} · An unofficial Pokémon field guide`;
const desc =
  description ??
  "Every Pokémon, move, ability, type and game, cross-linked in one fast field guide. Data from PokéAPI.";
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const meta = getMeta();

const nav = [
  { href: "/pokemon/", label: "Pokémon" },
  { href: "/types/", label: "Types" },
  { href: "/moves/", label: "Moves" },
  { href: "/abilities/", label: "Abilities" },
  { href: "/games/", label: "Games" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://raw.githubusercontent.com" crossorigin />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}
    <meta name="theme-color" content="#f3efe6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#13120f" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      try {
        const saved = localStorage.getItem("theme");
        if (saved === "light" || saved === "dark") document.documentElement.dataset.theme = saved;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href="/" aria-label="Fieldbook home">
          <Logo />
          <span>Fieldbook</span>
        </a>
        <nav class="nav" aria-label="Main">
          {
            nav.map((item) => (
              <a href={item.href} aria-current={path.startsWith(item.href) ? "page" : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>
        <div class="tools">
          <button class="search-trigger" type="button" data-open-search aria-label="Search">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"
              ><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5" stroke-linecap="round"></path></svg
            >
            <span class="search-label">Search</span>
            <kbd class="mono">/</kbd>
          </button>
          <button class="icon-btn" type="button" data-theme-toggle aria-label="Switch colour theme">
            <svg class="sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"
              ><circle cx="12" cy="12" r="4"></circle><path
                d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
                stroke-linecap="round"></path></svg
            >
            <svg class="moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"
              ><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z" stroke-linejoin="round"></path></svg
            >
          </button>
          <button class="icon-btn menu-btn" type="button" aria-label="Menu" aria-expanded="false" data-menu>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"
              ><path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"></path></svg
            >
          </button>
        </div>
      </div>
      <nav class="wrap mobile-nav" aria-label="Main" hidden>
        {nav.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap foot">
        <div class="foot-brand">
          <a class="brand" href="/"><Logo size={26} /><span>Fieldbook</span></a>
          <p class="muted">
            An unofficial field guide to {meta.counts.species.toLocaleString("en")} Pokémon, built from open data.
          </p>
        </div>
        <nav class="foot-links" aria-label="Footer">
          {nav.map((item) => <a href={item.href}>{item.label}</a>)}
          <a href="/about/">About and credits</a>
        </nav>
        <p class="legal">
          Data from <a href="https://pokeapi.co/">PokéAPI</a>. Pokémon and Pokémon character names are trademarks of
          Nintendo, Creatures Inc. and GAME FREAK inc. This is a fan reference, not affiliated with or endorsed by them.
        </p>
      </div>
    </footer>

    <dialog class="search" aria-label="Search">
      <div class="search-box">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"
          ><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5" stroke-linecap="round"></path></svg
        >
        <input
          type="search"
          placeholder="Pokémon, moves, abilities, types…"
          autocomplete="off"
          spellcheck="false"
          aria-label="Search the guide"
          aria-controls="search-results"
          role="combobox"
          aria-expanded="true"
        />
        <kbd class="mono">esc</kbd>
      </div>
      <ul id="search-results" class="search-results" role="listbox"></ul>
      <p class="search-hint label">↑ ↓ to move · enter to open</p>
    </dialog>

    <script>
      import "../scripts/site";
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -999px;
    top: 8px;
    z-index: 100;
    background: var(--ink);
    color: var(--paper);
    padding: 8px 14px;
    border-radius: 8px;
  }

  .skip:focus {
    left: 8px;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in oklab, var(--paper) 86%, transparent);
    backdrop-filter: blur(14px) saturate(1.4);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    border-bottom: 1px solid var(--line);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 24px;
    height: 64px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-weight: 620;
    font-size: 1.3rem;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .nav {
    display: flex;
    gap: 4px;
  }

  .nav a {
    padding: 8px 12px;
    border-radius: 999px;
    text-decoration: none;
    color: var(--ink-2);
    font-size: 0.95rem;
    font-weight: 500;
  }

  .nav a:hover {
    color: var(--ink);
    background: var(--paper-2);
  }

  .nav a[aria-current="page"] {
    color: var(--ink);
    background: var(--paper-2);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .tools {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .search-trigger {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 38px;
    padding: 0 8px 0 14px;
    min-width: 220px;
    border-radius: 999px;
    border: 1px solid var(--line-2);
    background: var(--card);
    color: var(--muted);
    cursor: pointer;
  }

  .search-trigger:hover {
    border-color: var(--ink-2);
  }

  .search-label {
    flex: 1;
    text-align: left;
    font-size: 0.92rem;
  }

  kbd {
    display: inline-grid;
    place-items: center;
    min-width: 22px;
    height: 22px;
    padding: 0 6px;
    border-radius: 6px;
    border: 1px solid var(--line-2);
    background: var(--paper);
    font-size: 0.7rem;
    color: var(--muted);
  }

  .icon-btn {
    display: inline-grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid var(--line-2);
    background: var(--card);
    cursor: pointer;
  }

  .icon-btn:hover {
    border-color: var(--ink-2);
  }

  .moon {
    display: none;
  }

  :global([data-theme="dark"]) .sun {
    display: none;
  }

  :global([data-theme="dark"]) .moon {
    display: block;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .sun {
      display: none;
    }

    :global(:root:not([data-theme="light"])) .moon {
      display: block;
    }
  }

  .menu-btn {
    display: none;
  }

  .mobile-nav {
    display: flex;
    flex-direction: column;
    padding-bottom: 12px;
  }

  .mobile-nav[hidden] {
    display: none;
  }

  .mobile-nav a {
    padding: 12px 0;
    border-top: 1px solid var(--line);
    text-decoration: none;
    font-weight: 500;
  }

  @media (max-width: 960px) {
    .nav {
      display: none;
    }

    .menu-btn {
      display: inline-grid;
    }

    .search-trigger {
      min-width: 0;
    }
  }

  @media (max-width: 560px) {
    .search-trigger {
      width: 38px;
      padding: 0;
      justify-content: center;
    }

    .search-label,
    .search-trigger kbd {
      display: none;
    }
  }

  .site-footer {
    margin-top: 48px;
    border-top: 1px solid var(--line);
    background: var(--paper-2);
  }

  .foot {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 32px;
    padding-block: 48px;
  }

  .foot-brand p {
    margin-top: 12px;
    max-width: 38ch;
  }

  .foot-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 24px;
    align-content: start;
  }

  .foot-links a {
    text-decoration: none;
    color: var(--ink-2);
  }

  .foot-links a:hover {
    color: var(--ink);
  }

  .legal {
    grid-column: 1 / -1;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    font-size: 0.82rem;
    color: var(--muted);
    max-width: 90ch;
  }

  @media (max-width: 720px) {
    .foot {
      grid-template-columns: 1fr;
    }
  }

  .search {
    width: min(640px, calc(100vw - 24px));
    max-height: min(560px, calc(100vh - 80px));
    margin: 10vh auto auto;
    padding: 0;
    border: 1px solid var(--line-2);
    border-radius: 18px;
    background: var(--card);
    color: var(--ink);
    box-shadow: 0 30px 80px -20px rgb(0 0 0 / 0.45);
    overflow: hidden;
  }

  .search[open] {
    display: flex;
    flex-direction: column;
  }

  .search::backdrop {
    background: rgb(20 18 14 / 0.45);
    backdrop-filter: blur(3px);
  }

  .search-box {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 16px;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
  }

  .search-box input {
    flex: 1;
    height: 58px;
    border: 0;
    background: none;
    outline: none;
    font-size: 1.1rem;
    color: var(--ink);
  }

  .search-box input::-webkit-search-cancel-button {
    display: none;
  }

  .search-results {
    list-style: none;
    margin: 0;
    padding: 8px;
    overflow-y: auto;
    flex: 1;
  }

  .search-hint {
    padding: 10px 16px;
    border-top: 1px solid var(--line);
  }
</style>
